{
  "kc": "math.vector-arithmetic",
  "problems": [
    {
      "id": 50032,
      "kind": "compute",
      "difficulty": 25,
      "prompt": "For u = (2, −1, 3) and v = (−4, 5, 1), find u + v.",
      "choices": [
        {
          "key": "A",
          "text": "(−2, 4, 4)",
          "value": "Matrix([-2,4,4])"
        },
        {
          "key": "B",
          "text": "(6, −6, 2)",
          "value": "Matrix([6,-6,2])"
        },
        {
          "key": "C",
          "text": "(−8, −5, 3)",
          "value": "Matrix([-8,-5,3])"
        },
        {
          "key": "D",
          "text": "(−2, −4, 4)",
          "value": "Matrix([-2,-4,4])"
        }
      ],
      "answer": "A",
      "solution": "Add matching components. Subtraction, elementwise multiplication, and dropping the sign of 5 give the other options.",
      "verify": {
        "sympy": {
          "truth": "Matrix([2,-1,3])+Matrix([-4,5,1])"
        }
      }
    },
    {
      "id": 50033,
      "kind": "compute",
      "difficulty": 25,
      "prompt": "Find −2(1, −3, 2).",
      "choices": [
        {
          "key": "A",
          "text": "(−2, −6, −4)",
          "value": "Matrix([-2,-6,-4])"
        },
        {
          "key": "B",
          "text": "(−2, 6, −4)",
          "value": "Matrix([-2,6,-4])"
        },
        {
          "key": "C",
          "text": "(1, 6, 2)",
          "value": "Matrix([1,6,2])"
        },
        {
          "key": "D",
          "text": "(2, −6, 4)",
          "value": "Matrix([2,-6,4])"
        }
      ],
      "answer": "B",
      "solution": "Multiply every component by −2. In particular, a negative times a negative is positive.",
      "verify": {
        "sympy": {
          "truth": "-2*Matrix([1,-3,2])"
        }
      }
    },
    {
      "id": 50034,
      "kind": "compute",
      "difficulty": 40,
      "prompt": "A = (−1, 2, 4), B = (3, −1, 6). Find the displacement from A to B.",
      "choices": [
        {
          "key": "A",
          "text": "(2, 1, 10)",
          "value": "Matrix([2,1,10])"
        },
        {
          "key": "B",
          "text": "(−4, 3, −2)",
          "value": "Matrix([-4,3,-2])"
        },
        {
          "key": "C",
          "text": "(4, −3, 2)",
          "value": "Matrix([4,-3,2])"
        },
        {
          "key": "D",
          "text": "(4, 3, 2)",
          "value": "Matrix([4,3,2])"
        }
      ],
      "answer": "C",
      "solution": "Use B − A = (4, −3, 2). Adding positions is not a displacement; A − B points the other way.",
      "verify": {
        "sympy": {
          "truth": "Matrix([3,-1,6])-Matrix([-1,2,4])"
        }
      }
    },
    {
      "id": 50035,
      "kind": "compute",
      "difficulty": 40,
      "prompt": "Let p = (1, −2), u = (3, 1), v = (−1, 4). Find p + 2u − v.",
      "choices": [
        {
          "key": "A",
          "text": "(6, 4)",
          "value": "Matrix([6,4])"
        },
        {
          "key": "B",
          "text": "(8, −6)",
          "value": "Matrix([8,-6])"
        },
        {
          "key": "C",
          "text": "(5, −5)",
          "value": "Matrix([5,-5])"
        },
        {
          "key": "D",
          "text": "(8, −4)",
          "value": "Matrix([8,-4])"
        }
      ],
      "answer": "D",
      "solution": "First 2u = (6, 2). Subtracting v adds 1 to x and subtracts 4 from y: (8, −4).",
      "verify": {
        "sympy": {
          "truth": "Matrix([1,-2])+2*Matrix([3,1])-Matrix([-1,4])"
        }
      }
    },
    {
      "id": 50036,
      "kind": "statement",
      "difficulty": 55,
      "prompt": "Both points A and B are translated by T. Which expression still equals the original displacement B − A?",
      "choices": [
        {
          "key": "A",
          "text": "(B + T) − (A + T)"
        },
        {
          "key": "B",
          "text": "(B + T) − A"
        },
        {
          "key": "C",
          "text": "B − (A + T)"
        },
        {
          "key": "D",
          "text": "(A + T) − (B + T)"
        }
      ],
      "answer": "A",
      "solution": "Translation cancels when applied to both points. Translating only one adds or subtracts T; reversing the order negates the displacement."
    },
    {
      "id": 50037,
      "kind": "compute",
      "difficulty": 55,
      "prompt": "A = (2, 0, −1), B = (6, 4, 3). Find A + (B − A)/4.",
      "choices": [
        {
          "key": "A",
          "text": "(1, 1, 1)",
          "value": "Matrix([1,1,1])"
        },
        {
          "key": "B",
          "text": "(3, 1, 0)",
          "value": "Matrix([3,1,0])"
        },
        {
          "key": "C",
          "text": "(4, 2, 1)",
          "value": "Matrix([4,2,1])"
        },
        {
          "key": "D",
          "text": "(8, 4, 2)",
          "value": "Matrix([8,4,2])"
        }
      ],
      "answer": "B",
      "solution": "B − A = (4, 4, 4). A quarter is (1, 1, 1); add A to get (3, 1, 0). A displacement alone is not the resulting point.",
      "verify": {
        "sympy": {
          "truth": "Matrix([2,0,-1])+(Matrix([6,4,3])-Matrix([2,0,-1]))/4"
        }
      }
    },
    {
      "id": 50062,
      "kind": "compute",
      "difficulty": 45,
      "prompt": "A = (4, −2, 7), B = (−1, 3, 2). Which point P satisfies P − A = 3(B − A)?",
      "choices": [
        {
          "key": "A",
          "text": "(−15, 15, −15)",
          "value": "Matrix([-15,15,-15])"
        },
        {
          "key": "B",
          "text": "(−7, 11, −1)",
          "value": "Matrix([-7,11,-1])"
        },
        {
          "key": "C",
          "text": "(−11, 13, −8)",
          "value": "Matrix([-11,13,-8])"
        },
        {
          "key": "D",
          "text": "(1, 7, 13)",
          "value": "Matrix([1,7,13])"
        }
      ],
      "answer": "C",
      "solution": "$P = A + 3(B - A) = (4, -2, 7) + (-15, 15, -15) = (-11, 13, -8)$.\n\n- A: that is $3(B - A)$, the displacement, not the point it lands on.\n- B: $3B - A$ scales the endpoint instead of the displacement.\n- D: $A + 3B$ adds positions.",
      "verify": {
        "sympy": {
          "truth": "Matrix([4,-2,7])+3*(Matrix([-1,3,2])-Matrix([4,-2,7]))"
        }
      }
    },
    {
      "id": 50063,
      "kind": "compute",
      "difficulty": 45,
      "prompt": "Which scalar c makes c(−2, 3, −1) = (6, −9, 3)?",
      "choices": [
        {
          "key": "A",
          "text": "3",
          "value": "3"
        },
        {
          "key": "B",
          "text": "−1/3",
          "value": "-Rational(1,3)"
        },
        {
          "key": "C",
          "text": "1/3",
          "value": "Rational(1,3)"
        },
        {
          "key": "D",
          "text": "−3",
          "value": "-3"
        }
      ],
      "answer": "D",
      "solution": "Every component must scale by the same factor: $6/(-2) = -9/3 = 3/(-1) = -3$.\n\n- A: the sizes match but every sign flips, so the factor is negative.\n- B, C: these divide the wrong way round; $c$ multiplies $(-2, 3, -1)$.",
      "verify": {
        "sympy": {
          "truth": "Rational(6,-2)"
        }
      }
    },
    {
      "id": 50064,
      "kind": "statement",
      "difficulty": 50,
      "prompt": "Are u = (2, −4, 6) and w = (−3, 6, −9) parallel?",
      "choices": [
        {
          "key": "A",
          "text": "No: their components have different signs"
        },
        {
          "key": "B",
          "text": "Yes: w = −1.5u, so they point in opposite directions"
        },
        {
          "key": "C",
          "text": "Yes: w = 1.5u, so they point the same way"
        },
        {
          "key": "D",
          "text": "No: no single scalar turns u into w"
        }
      ],
      "answer": "B",
      "solution": "$-1.5 \\cdot (2, -4, 6) = (-3, 6, -9) = w$. One scalar works for every component, so they are parallel; it is negative, so they point opposite ways.\n\n- A: a negative scalar flips every sign; parallel does not mean same direction.\n- C: $1.5u = (3, -6, 9) \\neq w$.\n- D: $-1.5$ is that scalar."
    },
    {
      "id": 50065,
      "kind": "compute",
      "difficulty": 50,
      "prompt": "u = (1, 2, −1), v = (3, 0, 2). Solve 2x + u = v for the vector x.",
      "choices": [
        {
          "key": "A",
          "text": "(2, −2, 3)",
          "value": "Matrix([2,-2,3])"
        },
        {
          "key": "B",
          "text": "(2, 1, 0.5)",
          "value": "Matrix([2,1,Rational(1,2)])"
        },
        {
          "key": "C",
          "text": "(4, −4, 6)",
          "value": "Matrix([4,-4,6])"
        },
        {
          "key": "D",
          "text": "(1, −1, 1.5)",
          "value": "Matrix([1,-1,Rational(3,2)])"
        }
      ],
      "answer": "D",
      "solution": "Subtract $u$, then halve: $x = (v - u)/2 = (2, -2, 3)/2 = (1, -1, 1.5)$.\n\n- A: $v - u$ stops before dividing by 2.\n- B: $(v + u)/2$ adds $u$ instead of moving it across.\n- C: $2(v - u)$ multiplies where it should divide.",
      "verify": {
        "sympy": {
          "truth": "(Matrix([3,0,2])-Matrix([1,2,-1]))/2"
        }
      }
    },
    {
      "id": 50066,
      "kind": "compute",
      "difficulty": 50,
      "prompt": "A = (0, 3, −3), B = (6, 0, 3). Which point is one third of the way from A to B?",
      "choices": [
        {
          "key": "A",
          "text": "(2, 2, −1)",
          "value": "Matrix([2,2,-1])"
        },
        {
          "key": "B",
          "text": "(4, 1, 1)",
          "value": "Matrix([4,1,1])"
        },
        {
          "key": "C",
          "text": "(2, −1, 2)",
          "value": "Matrix([2,-1,2])"
        },
        {
          "key": "D",
          "text": "(3, 1.5, 0)",
          "value": "Matrix([3,Rational(3,2),0])"
        }
      ],
      "answer": "A",
      "solution": "$A + \\tfrac13(B - A) = (0, 3, -3) + \\tfrac13(6, -3, 6) = (2, 2, -1)$.\n\n- B: two thirds of the way.\n- C: $\\tfrac13(B - A)$ is the step, not the point.\n- D: the midpoint.",
      "verify": {
        "sympy": {
          "truth": "Matrix([0,3,-3])+(Matrix([6,0,3])-Matrix([0,3,-3]))/3"
        }
      }
    },
    {
      "id": 50067,
      "kind": "compute",
      "difficulty": 45,
      "prompt": "A point starts at O = (1, 1, 1) and moves along D = (2, −1, 0). Where is O + sD at s = 0.5?",
      "choices": [
        {
          "key": "A",
          "text": "(5, −1, 1)",
          "value": "Matrix([5,-1,1])"
        },
        {
          "key": "B",
          "text": "(2, 0.5, 1)",
          "value": "Matrix([2,Rational(1,2),1])"
        },
        {
          "key": "C",
          "text": "(1.5, 0, 0.5)",
          "value": "Matrix([Rational(3,2),0,Rational(1,2)])"
        },
        {
          "key": "D",
          "text": "(2.5, −0.5, 0.5)",
          "value": "Matrix([Rational(5,2),Rational(-1,2),Rational(1,2)])"
        }
      ],
      "answer": "B",
      "solution": "$O + 0.5D = (1, 1, 1) + (1, -0.5, 0) = (2, 0.5, 1)$.\n\n- A: $O + 2D$ uses $s = 2$.\n- C: $0.5(O + D)$ also halves the starting point.\n- D: $D + 0.5O$ swaps the roles of the starting point and the direction.",
      "verify": {
        "sympy": {
          "truth": "Matrix([1,1,1])+Rational(1,2)*Matrix([2,-1,0])"
        }
      }
    },
    {
      "id": 50069,
      "kind": "compute",
      "difficulty": 60,
      "prompt": "A segment is stored as [[1, 2, 0], [5, −2, 4]]: row 0 is A, row 1 is B. Which point is three quarters of the way from A to B?",
      "choices": [
        {
          "key": "A",
          "text": "(2, 1, 1)",
          "value": "Matrix([2,1,1])"
        },
        {
          "key": "B",
          "text": "(4, −1, 3)",
          "value": "Matrix([4,-1,3])"
        },
        {
          "key": "C",
          "text": "(3.75, −1.5, 3)",
          "value": "Matrix([Rational(15,4),Rational(-3,2),3])"
        },
        {
          "key": "D",
          "text": "(3, 0, 2)",
          "value": "Matrix([3,0,2])"
        }
      ],
      "answer": "B",
      "solution": "$A + \\tfrac34(B - A) = (1, 2, 0) + \\tfrac34(4, -4, 4) = (4, -1, 3)$.\n\n- A: one quarter of the way.\n- C: $\\tfrac34 B$ scales the endpoint, not the displacement.\n- D: the midpoint.",
      "verify": {
        "sympy": {
          "truth": "Matrix([1,2,0])+Rational(3,4)*(Matrix([5,-2,4])-Matrix([1,2,0]))"
        }
      }
    },
    {
      "id": 50070,
      "kind": "compute",
      "difficulty": 65,
      "prompt": "ABCD is a parallelogram with its vertices in that order. A = (1, 0, 2), B = (4, 1, 2), D = (0, 3, 1). Find C.",
      "choices": [
        {
          "key": "A",
          "text": "(3, 4, 1)",
          "value": "Matrix([3,4,1])"
        },
        {
          "key": "B",
          "text": "(5, −2, 3)",
          "value": "Matrix([5,-2,3])"
        },
        {
          "key": "C",
          "text": "(4, 4, 3)",
          "value": "Matrix([4,4,3])"
        },
        {
          "key": "D",
          "text": "(−3, 2, 1)",
          "value": "Matrix([-3,2,1])"
        }
      ],
      "answer": "A",
      "solution": "Side $DC$ is the same displacement as side $AB$: $C = D + (B - A) = (0, 3, 1) + (3, 1, 0) = (3, 4, 1)$.\n\n- B: $A + B - D$ is the vertex opposite $D$ in a different parallelogram.\n- C: $B + D$ adds two positions.\n- D: $A + D - B$ puts the fourth vertex opposite $B$.",
      "verify": {
        "sympy": {
          "truth": "Matrix([0,3,1])+Matrix([4,1,2])-Matrix([1,0,2])"
        }
      }
    },
    {
      "id": 50071,
      "kind": "statement",
      "difficulty": 60,
      "prompt": "Two directions D₁ = (1, 2, 0) and D₂ = (3, 6, 0) start from the same point O = (2, 1, 0). Compare the points O + 3D₁ and O + D₂.",
      "choices": [
        {
          "key": "A",
          "text": "Different points on the same line"
        },
        {
          "key": "B",
          "text": "Different points on different lines"
        },
        {
          "key": "C",
          "text": "The same point, (5, 7, 0), because D₂ = 3D₁"
        },
        {
          "key": "D",
          "text": "The same point only if O were the origin"
        }
      ],
      "answer": "C",
      "solution": "$D_2 = 3D_1$, so $O + 3D_1 = O + D_2 = (5, 7, 0)$. A direction's length changes which parameter reaches a point, not which points the line through O covers.\n\n- A: they are on the same line and are also the same point.\n- B: parallel directions from one point give one line.\n- D: the shared starting point cancels whatever it is."
    }
  ]
}
